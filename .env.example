# Identifiants des tests de parcours (Playwright) et des campagnes d'intrusion.
#
# Copiez ce fichier en `.env.local` et renseignez les valeurs : Playwright le
# lit automatiquement. `.env.local` est ignoré par Git.
#
# Sans ces variables, la suite connectée est IGNORÉE — ce qui ressemble à un
# succès et n'en est pas : vérifiez toujours le nombre de tests « skipped ».
#
# Ce sont des comptes de démonstration, à supprimer avant la production.

VEHORA_TEST_EMAIL=awa@vehora.test
VEHORA_TEST_PASSWORD=

VEHORA_TEST_EMAIL_CAISSIER=ousmane@vehora.test
VEHORA_TEST_PASSWORD_CAISSIER=

# Compte de plateforme (espace Super Admin)
VEHORA_TEST_PASSWORD_ADMIN=

# Compte volontairement sans organisation
VEHORA_TEST_EMAIL_SANS_ORG=sansorg@vehora.test
VEHORA_TEST_PASSWORD_SANS_ORG=

# UNIQUEMENT en environnement cloud : chemin du Chromium préinstallé.
# En local, laissez cette ligne absente — Playwright utilise son propre
# navigateur, installé par `npx playwright install chromium`.
# VEHORA_CHROMIUM=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
